  "capabilities": {
    "kepler.command.doctor.v1": {
      "kind": "command",
      "description": "Read-only structured workspace diagnostics.",
      "probe": {
        "help_contains": "bin/kepler doctor "
      },
      "managed_paths": [
        "bin/kepler",
        "lib/kepler/cli.rb",
        "lib/kepler/doctor.rb"
      ],
      "fallback": {
        "mode": "compatibility_report_only"
      }
    },
    "kepler.command.status.v1": {
      "kind": "command",
      "description": "Read-only status rendering with an explicit write option.",
      "probe": {
        "help_contains": "bin/kepler status "
      },
      "managed_paths": [
        "bin/kepler",
        "lib/kepler/cli.rb",
        "lib/kepler/doctor.rb"
      ],
      "fallback": {
        "mode": "compatibility_report_only"
      }
    },
    "kepler.command.status-token-efficiency.v1": {
      "kind": "command",
      "description": "Plan status with ContextPack and WorkerResult artifact token estimates that explicitly leave runtime usage unavailable.",
