        "help_contains": "bin/kepler route plan "
      },
      "managed_paths": [
        "bin/kepler",
        "kepler.yaml",
        "hub/schemas/kepler.schema.json",
        "hub/schemas/dispatch-receipt.schema.json",
        "lib/kepler/contracts.rb",
        "lib/kepler/doctor.rb",
        "lib/kepler/plan_store.rb",
        "lib/kepler/route_planner.rb"
      ],
      "fallback": {
        "mode": "bundled_reference",
        "reference": "skills/kepler/references/dispatch.md"
      }
    },
    "kepler.command.cli-herdr-dispatch.v1": {
      "kind": "command",
      "description": "Desktop-independent Herdr dispatch through the persistent CLI project registry, worker tabs inside the current control workspace, exact prompt delivery, final-response-only result collection, and preview-authorized cleanup.",
