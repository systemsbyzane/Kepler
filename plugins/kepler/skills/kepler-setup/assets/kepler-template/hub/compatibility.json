        "hub/schemas/dispatch-receipt.schema.json",
        "lib/kepler/contracts.rb",
        "lib/kepler/plan_store.rb",
        "lib/kepler/setup_store.rb",
        "docs/codex-ui-workflow.md",
        "docs/workflows/thread-routing.md",
        "docs/workflow.md"
