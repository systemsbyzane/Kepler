{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kepler.dev/schemas/plan.schema.json",
  "title": "Kepler Plan",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "objective", "status", "units"],
  "properties": {
    "api_version": {"const": "kepler.dev/v1"},
    "kind": {"const": "Plan"},
    "metadata": {"type": "object", "required": ["id", "revision"], "properties": {"id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}}},
    "objective": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["draft", "ready", "dispatched", "working", "blocked", "completed", "failed", "cancelled"]}}},
    "units": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "workspace", "domain", "paths", "dependencies"], "properties": {"id": {"type": "string"}, "workspace": {"type": "string"}, "domain": {"type": "string"}, "paths": {"type": "array", "items": {"type": "string"}}, "dependencies": {"type": "array", "items": {"type": "string"}}, "status": {"oneOf": [{"type": "string"}, {"type": "object"}]}, "retry": {"type": "boolean"}}}}
  }
}
