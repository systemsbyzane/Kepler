{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kepler.dev/schemas/kepler.schema.json",
  "title": "Kepler Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "schema", "metadata", "workspace", "workloads", "repositories", "codex_projects", "providers", "environments", "automation_templates", "routing"],
  "properties": {
    "api_version": {"const": "kepler.dev/v1alpha1"},
    "kind": {"const": "KeplerRegistry"},
    "schema": {"const": "hub/schemas/kepler.schema.json"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"const": "kepler"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "workspace": {
      "type": "object",
      "required": ["root", "coordination_project_key", "architecture_map", "plans_root", "context_packs_root", "worker_results_root", "memory_root", "dispatch_receipts_root", "report_root", "policy_root", "local_registry", "bridge_registry", "repository_declarations", "project_registry", "bridge_setup_receipt", "implementation_policy", "runtime_state_policy"],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "coordination_project_key": {"const": "kepler"},
        "implementation_policy": {"const": "selected_project_only"},
        "runtime_state_policy": {"const": "structured_coordination_state"}
      }
    },
    "workloads": {"type": "object", "maxProperties": 0},
    "repositories": {"type": "object"},
    "codex_projects": {"type": "object", "required": ["kepler"], "maxProperties": 1},
    "providers": {"type": "object"},
    "environments": {"type": "object", "maxProperties": 0},
    "automation_templates": {
      "type": "object",
      "required": ["root", "activation_policy", "default_enabled"],
      "properties": {
        "activation_policy": {"const": "explicit_user_enablement"},
        "default_enabled": {"const": false}
      }
    },
    "routing": {
      "type": "object",
      "required": ["default_coordination_project_key", "planner_runtime", "dispatcher_runtime", "task_launch_policy", "dispatch_receipt_policy", "post_dispatch_policy", "monitoring_policy", "existing_task_policy", "project_registration_policy", "bridge_policy", "mode_defaults"],
      "properties": {
        "default_coordination_project_key": {"const": "kepler"},
        "planner_runtime": {"$ref": "#/$defs/runtime"},
        "dispatcher_runtime": {"$ref": "#/$defs/runtime"},
        "task_launch_policy": {"const": "explicit_kepler_dispatch"},
        "dispatch_receipt_policy": {"const": "required"},
        "post_dispatch_policy": {"const": "return_receipt_without_monitoring"},
        "monitoring_policy": {"const": "user_initiated_only"},
        "existing_task_policy": {"const": "resume_exact_match"},
        "project_registration_policy": {"const": "existing_saved_projects_exact_path"},
        "bridge_policy": {"const": "optional_advanced_fail_closed_when_configured"},
        "mode_defaults": {"type": "object"}
      }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model", "thinking"],
      "properties": {
        "role": {"enum": ["sol", "terra"]},
        "model": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra"]},
        "thinking": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}
      }
    }
  }
}
