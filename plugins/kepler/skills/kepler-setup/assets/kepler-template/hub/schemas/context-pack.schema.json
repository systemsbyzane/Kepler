{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kepler.dev/schemas/context-pack.schema.json",
  "title": "Kepler ContextPack",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "parent_plan", "objective", "scope", "worker_policy"],
  "properties": {
    "api_version": {"const": "kepler.dev/v1"},
    "kind": {"const": "ContextPack"},
    "metadata": {"type": "object", "required": ["id", "estimated_tokens", "token_budget"]},
    "parent_plan": {"type": "object", "required": ["id", "revision"]},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "required": ["workspace", "codex_project", "runtime_project_id", "project_path", "domain", "paths"]},
    "worker_policy": {
      "type": "object",
      "required": ["initial_context_not_boundary", "return_worker_result", "result_token_budget", "structured_result_only", "avoid_context_repetition"],
      "properties": {
        "initial_context_not_boundary": {"const": true},
        "return_worker_result": {"const": true},
        "result_token_budget": {"type": "integer", "minimum": 1},
        "structured_result_only": {"const": true},
        "avoid_context_repetition": {"const": true}
      }
    }
  }
}
